<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <tts.smartvoice.ui.Slider
        android:title="@string/intonation_setting"
        android:key="@string/intonation_key"
        android:max="@integer/intonation_max"
        android:defaultValue="@integer/intonation_value"
        android:persistent="true"
        app:iconSpaceReserved="false" />

    <tts.smartvoice.ui.Slider
        android:title="@string/interclause_gap_setting"
        android:key="@string/interclause_gap_key"
        android:max="@integer/interclause_gap_max"
        android:defaultValue="@integer/interclause_gap_value"
        android:persistent="true"
        app:iconSpaceReserved="false" />

    <CheckBoxPreference
        android:title="@string/pref_use_rulex_title"
        android:key="@string/pref_use_rulex_key"
        android:defaultValue="@bool/pref_use_rulex_state"
        android:persistent="true"
        app:singleLineTitle="false"
        app:iconSpaceReserved="false" />

    <CheckBoxPreference
        android:title="@string/pref_decimal_point_title"
        android:key="@string/pref_decimal_point_key"
        android:defaultValue="@bool/pref_decimal_point_state"
        android:persistent="true"
        app:singleLineTitle="false"
        app:iconSpaceReserved="false" />

    <CheckBoxPreference
        android:title="@string/pref_decimal_comma_title"
        android:key="@string/pref_decimal_comma_key"
        android:defaultValue="@bool/pref_decimal_comma_state"
        android:persistent="true"
        app:singleLineTitle="false"
        app:iconSpaceReserved="false" />

    <CheckBoxPreference
        android:title="@string/pref_speak_quotes_title"
        android:key="@string/pref_speak_quotes_key"
        android:defaultValue="@bool/pref_speak_quotes_state"
        android:persistent="true"
        app:singleLineTitle="false"
        app:iconSpaceReserved="false" />

    <CheckBoxPreference
        android:title="@string/pref_speak_parenthesis_title"
        android:key="@string/pref_speak_parenthesis_key"
        android:defaultValue="@bool/pref_speak_parenthesis_state"
        android:persistent="true"
        app:singleLineTitle="false"
        app:iconSpaceReserved="false" />

</PreferenceScreen>
