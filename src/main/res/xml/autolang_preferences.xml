<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <CheckBoxPreference
        android:title="@string/use_only_default_or_requested_voice_title"
        android:key="@string/use_only_default_or_requested_voice_key"
        android:defaultValue="@bool/use_only_default_or_requested_voice_state"
        android:persistent="true"
        app:singleLineTitle="false"
        app:iconSpaceReserved="false" />

    <CheckBoxPreference
        android:title="@string/use_default_locale_title"
        android:key="@string/use_default_locale_key"
        android:defaultValue="@bool/use_default_locale_state"
        android:persistent="true"
        app:singleLineTitle="false"
        app:iconSpaceReserved="false" />

    <MultiSelectListPreference
        android:title="@string/pref_languages_auto"
        android:key="@string/pref_languages_auto_key"
        android:persistent="true"
        app:singleLineTitle="false"
        app:iconSpaceReserved="false" />

    <tts.smartvoice.ui.LanguageOrderPreference
        android:title="@string/language_detection_order_title"
        android:dialogLayout="@layout/list_dialog_fragment"
        android:dialogMessage="@string/language_detection_order_explanation"
        android:key="@string/language_detection_order_key"
        android:persistent="true"
        app:singleLineTitle="false"
        app:iconSpaceReserved="false" />

    <CheckBoxPreference
        android:title="@string/one_voice_per_message_title"
        android:key="@string/one_voice_per_message_key"
        android:defaultValue="@bool/one_voice_per_message_state"
        android:persistent="true"
        app:singleLineTitle="false"
        app:iconSpaceReserved="false" />

    <MultiSelectListPreference
        android:title="@string/pref_languages_sticky"
        android:key="@string/pref_languages_sticky_key"
        android:persistent="true"
        app:singleLineTitle="false"
        app:iconSpaceReserved="false" />

</PreferenceScreen>
